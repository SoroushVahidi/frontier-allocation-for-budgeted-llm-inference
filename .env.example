# Example local environment template.
# Copy to `.env` for local use only. Never put real credentials in this file.

OPENAI_API_KEY=replace_with_provider_key
AZURE_OPENAI_API_KEY=replace_with_provider_key
AZURE_OPENAI_ENDPOINT=replace_with_provider_endpoint
AZURE_OPENAI_DEPLOYMENT=replace_with_deployment_name
FIREWORKS_API_KEY=replace_with_provider_key
VERTEX_PROJECT_ID=replace_with_project_id
VERTEX_LOCATION=replace_with_location
GOOGLE_APPLICATION_CREDENTIALS=replace_with_local_service_account_json_path
